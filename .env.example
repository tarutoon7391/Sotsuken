# このファイルを .env にコピーして値を入れる。.env はコミット禁止。

# サーバー
PORT=3000
NODE_ENV=development

# セッション（本番は必ず長いランダム文字列にする）
SESSION_SECRET=change-me

# MySQL 8（Railway では MySQL サービスの MYSQL_URL を参照させる）
# 例：mysql://ユーザー:パスワード@localhost:3306/sotsuken
DATABASE_URL=

# LiveKit（開発は LiveKit Cloud。シークレットはサーバー側だけで使う）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# アップロード先（本番は Railway Volume のマウント先を指定する）
UPLOAD_DIR=./uploads
