# このファイルを .env にコピーして値を入れる。.env はコミット禁止。
# worktree（w1-core 〜 w5-teach）ごとに .env を1つ置く。PORT / CLIENT_PORT は worktree ごとに変える。
#   本体: 3000/5173  w1: 3001/5174  w2: 3002/5175  w3: 3003/5176  w4: 3004/5177  w5: 3005/5178

# サーバー（Express + Socket.IO）
PORT=3000
NODE_ENV=development

# フロント開発サーバー（Vite）。/api /socket.io /uploads は PORT のサーバーへプロキシされる
CLIENT_PORT=5173

# セッション（本番は必ず長いランダム文字列にする）
SESSION_SECRET=change-me

# MySQL 8。Railway の MySQL サービスの接続文字列（MYSQL_URL）をそのまま入れる。
# DATABASE_URL と MYSQL_URL はどちらでもよい（DATABASE_URL が優先）。
# 空のままでもサーバーは起動する（DB を使う API は 500、セッションはメモリ保存）。
# ※ migrate（npm run migrate）はトーンさんだけが流す。ワーカーは実行しない。
MYSQL_URL=
DATABASE_URL=

# LiveKit（開発は LiveKit Cloud。シークレットはサーバー側だけで使う）
# 未設定でもサーバーは起動する（token API は url 空で返し、画面は「未設定」表示）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# アップロード先（本番は Railway Volume のマウント先 /data/uploads を指定する）
UPLOAD_DIR=./uploads

# Office 資料（Word・Excel・PowerPoint）を PDF に変換する LibreOffice のコマンド（v4.4）
# 未導入でもサーバーは動く（変換できない資料は preview_url が null になり、ダウンロードだけになる）
# Windows の例：SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=soffice

# ユーザー管理ページ（/admin/users）を使えるログインID（カンマ区切り）。未設定なら誰も使えない
ADMIN_LOGIN_IDS=

# F-10 プログラミングモードの実行サーバー（Piston）のベース URL（docs/04 §7.4）
# 開発：公開 API（秒 5 リクエスト制限）。本番：VPS 上の Piston（http://<VPS>:2000/api/v2）
# 未設定でもサーバーは動く（実行は 503 RUNNER_UNAVAILABLE、保存は compile.status が runner_unavailable になる）
# ※ 公開 API（emkc.org）は 2026-02-15 からホワイトリスト制で使えない。VPS に Piston をセルフホストする（docs/infra/piston-setup.md）
CODE_RUNNER_URL=
# 授業ごとの同時実行本数（未設定なら 4）。メモリ 1GB の VPS では 2 にする
CODE_RUNNER_CONCURRENCY=
